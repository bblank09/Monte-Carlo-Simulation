SEC_API_KEY=your_sec_opendata_key_here
# Existing MC environments may use SEC_OPENDATA_API_KEY instead; do not set
# both keys to different values because SEC_API_KEY takes precedence.
SEC_API_BASE_URL=https://api.sec.or.th
# Comma-separated browser origins. Keep this explicit; wildcard origins cannot
# be combined safely with credentialed requests.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
MAX_PERSISTED_RUNS=500
